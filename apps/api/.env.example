NODE_ENV="development"

API_HOST="0.0.0.0"
API_PORT="3000"
API_LOG_LEVEL="debug"

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

JWT_ACCESS_SECRET="replace-with-at-least-64-random-characters"
JWT_REFRESH_SECRET="replace-with-another-64-random-characters"

JWT_ACCESS_TOKEN_TTL_SECONDS="900"
JWT_REFRESH_TOKEN_TTL_SECONDS="2592000"

AUTH_COOKIE_NAME="vicehub_refresh_token"
AUTH_COOKIE_SECURE="false"

AUTH_MAX_FAILED_LOGIN_ATTEMPTS="5"
AUTH_LOCKOUT_DURATION_SECONDS="900"

CORS_ALLOWED_ORIGINS="https://vicehub.com,https://app.vicehub.com"