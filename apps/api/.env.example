NODE_ENV="development"

API_HOST="0.0.0.0"
API_PORT="3000"
API_LOG_LEVEL="debug"

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

JWT_ACCESS_SECRET="replace-with-at-least-64-random-characters"
JWT_REFRESH_SECRET="replace-with-another-64-random-characters"

JWT_ACCESS_TOKEN_TTL_SECONDS="900"
JWT_REFRESH_TOKEN_TTL_SECONDS="2592000"

AUTH_COOKIE_NAME="vicehub_refresh_token"
AUTH_COOKIE_SECURE="false"

AUTH_MAX_FAILED_LOGIN_ATTEMPTS="5"
AUTH_LOCKOUT_DURATION_SECONDS="900"

AUTH_RECOVERY_RATE_LIMIT_MAX="5"
AUTH_RECOVERY_RATE_LIMIT_WINDOW="15 minutes"

# Sem SMTP_URL os emails ficam no log em vez de serem enviados.
# SMTP_URL="smtp://USER:PASSWORD@HOST:587"
MAIL_FROM="ViceHub <no-reply@vicehub.local>"

APP_PUBLIC_URL="http://localhost:5173"
PASSWORD_RESET_TTL_SECONDS="3600"
EMAIL_VERIFICATION_TTL_SECONDS="86400"

CORS_ALLOWED_ORIGINS="https://vicehub.com,https://app.vicehub.com"

# A pasta com o apps/web já compilado, para a API a servir na sua própria
# origem. Em desenvolvimento fica por definir: quem serve a aplicação é o
# Vite. Em produção, ou se define isto, ou há um proxy à frente a servir
# as duas coisas no mesmo domínio — o cookie da sessão é SameSite=strict
# e não atravessa origens.
# WEB_DIST_PATH="../web/dist"

# Cobrança pelo Stripe. Os cinco andam juntos: ou estão todos, ou a
# plataforma arranca sem compra pelo próprio e a rota responde 503.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_ID="price_..."
# STRIPE_SUCCESS_URL="http://localhost:5173/premium?compra=feita"
# STRIPE_CANCEL_URL="http://localhost:5173/premium"