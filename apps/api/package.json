{
    "name": "@vicehub/api",
    "version": "0.1.0",
    "private": true,
    "description": "API REST do ecossistema ViceHub.",
    "type": "module",
    "main": "./dist/server.js",
    "scripts": {
        "build": "tsc --project tsconfig.build.json",
        "dev": "tsx watch src/server.ts",
        "start": "node dist/server.js",
        "typecheck": "tsc --project tsconfig.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "engines": {
        "node": ">=24.0.0",
        "npm": ">=11.0.0"
    },
    "dependencies": {
        "@fastify/cookie": "11.0.2",
        "@fastify/cors": "11.2.0",
        "@fastify/helmet": "13.0.2",
        "@fastify/jwt": "10.1.0",
        "@fastify/rate-limit": "11.1.0",
        "@vicehub/database": "0.1.0",
        "argon2": "0.44.0",
        "dotenv": "17.4.2",
        "fastify": "5.9.0",
        "fastify-plugin": "5.1.0",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@types/node": "26.1.0",
        "@vitest/coverage-v8": "4.1.9",
        "pino-pretty": "13.1.3",
        "tsx": "4.22.4",
        "typescript": "6.0.3",
        "vitest": "4.1.9"
    }
}
