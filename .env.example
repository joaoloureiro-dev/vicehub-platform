# Configuração do ViceHub.
#
# Copia este ficheiro para `.env` na raiz do repositório e preenche o que
# precisares. O `.env` está no .gitignore; este exemplo não, de propósito
# — é a lista do que existe, e uma lista que ninguém vê não serve.
#
# Nenhum valor aqui é real. Não ponhas segredos verdadeiros neste
# ficheiro: ele vai para o repositório.
#
# Cada secção diz o que acontece se a deixares em branco. As que dizem
# "a plataforma não arranca" são mesmo isso — a API recusa arrancar em
# vez de correr meia configurada.


# ─────────────────────────────────────────────────────────────────────
# Obrigatórias
# ─────────────────────────────────────────────────────────────────────

# Onde vive a base de dados. Sem isto a plataforma não arranca.
DATABASE_URL=postgresql://vicehub:password@localhost:5432/vicehub

# As duas chaves que assinam as sessões. Pelo menos 64 caracteres cada,
# e diferentes uma da outra. Sem isto a plataforma não arranca.
#
# Gera cada uma com:  openssl rand -hex 48
JWT_ACCESS_SECRET=troca-me-por-96-caracteres-aleatorios-gerados-com-openssl-rand-hex-48-nao-uses-isto
JWT_REFRESH_SECRET=troca-me-tambem-e-por-um-valor-diferente-do-de-cima-gerado-da-mesma-maneira-obrigado

# De que origens o browser pode falar com a API, separadas por vírgulas.
# Sem isto a plataforma não arranca.
#
# Se a API servir também a interface (ver WEB_DIST_PATH), é só o domínio.
CORS_ALLOWED_ORIGINS=https://vicehub.com


# ─────────────────────────────────────────────────────────────────────
# Produção
# ─────────────────────────────────────────────────────────────────────
# Estas têm valor por omissão que funciona em desenvolvimento e que em
# produção faz estragos silenciosos. Com NODE_ENV=production a API
# verifica-as ao arrancar e recusa arrancar se não estiverem bem.

NODE_ENV=production

# O cookie que mantém a sessão aberta só viaja cifrado com isto a true.
AUTH_COOKIE_SECURE=true

# O endereço público da plataforma. É daqui que saem os links dos emails
# de confirmação e de recuperação — deixá-lo em localhost manda toda a
# gente para a máquina de quem fez o deploy.
APP_PUBLIC_URL=https://vicehub.com

# Como se enviam emails. Em produção é obrigatória.
#
# Sem ela os emails não são enviados: são escritos no log. Ninguém
# confirma a conta, ninguém recupera a palavra-passe, e um link de
# recuperação escrito no log é uma chave para entrar numa conta ao
# alcance de quem lê logs. Por isso a API recusa arrancar sem ela.
SMTP_URL=smtp://utilizador:palavra-passe@smtp.exemplo.com:587
MAIL_FROM=ViceHub <no-reply@vicehub.com>


# ─────────────────────────────────────────────────────────────────────
# Servir a interface
# ─────────────────────────────────────────────────────────────────────

# A pasta com o `apps/web` já compilado, para a API a servir na sua
# própria origem.
#
# É opcional, mas se a interface ficar noutra origem o cookie do refresh
# token nunca chega à API — é SameSite=strict — e a sessão morre a cada
# F5 sem nada a indicar porquê. Ou defines isto, ou pões um proxy à
# frente que junte as duas na mesma origem.
WEB_DIST_PATH=/srv/vicehub/web


# ─────────────────────────────────────────────────────────────────────
# Opcionais: funcionalidades que ficam desligadas sem configuração
# ─────────────────────────────────────────────────────────────────────
# Nenhuma destas impede a plataforma de arrancar. Cada grupo é tudo ou
# nada: meia configuração é recusada ao arrancar, porque meia
# configuração falha mais tarde e em pior sítio.

# Comprar o plano premium pelo próprio.
#
# Sem isto a plataforma funciona toda, incluindo conceder planos à mão;
# o que não existe é o botão de pagar, que responde 503.
#
# As chaves saem do painel do Stripe. Nunca as escrevas aqui nem as
# mandes por conversa — vão só para o `.env` do servidor.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_SUCCESS_URL=https://vicehub.com/premium?estado=sucesso
# STRIPE_CANCEL_URL=https://vicehub.com/premium?estado=cancelado

# Um preço por plano, criado no painel do Stripe como preço recorrente
# mensal. **Um plano está à venda se, e só se, tiver preço aqui.**
#
# São independentes: dá para abrir só o da crew e deixar os escalões de
# servidor fechados, e abri-los depois um a um sem tocar em código nem
# fazer deploy. O que não dá é pôr chaves sem preço nenhum — isso é um
# botão de pagar que não sabe cobrar coisa nenhuma, e a API recusa
# arrancar.
#
# Os valores do catálogo, para conferires ao criá-los no Stripe:
#   premium           4,99 €/mês   — a tesouraria de uma crew
#   server_base      14,99 €/mês   — até 10 crews no servidor
#   server_plus      19,99 €/mês   — até 50 crews
#   server_unlimited 99,99 €/mês   — sem limite
#
# O preço cobrado é o do Stripe, não o do catálogo: se os dois
# divergirem, quem cobra é o Stripe e o ecrã mostra o do catálogo. Vale
# a pena confirmar que batem certo.
# STRIPE_PRICE_PREMIUM=price_...
# STRIPE_PRICE_SERVER_BASE=price_...
# STRIPE_PRICE_SERVER_PLUS=price_...
# STRIPE_PRICE_SERVER_UNLIMITED=price_...

# Entrar com Discord.
#
# Sem isto o botão do Discord não aparece; entrar com email continua a
# funcionar.
#
# O endereço de retorno tem de ser exatamente o que registaste no portal
# do Discord — é ele que compara, e uma barra a mais é uma recusa sem
# explicação nenhuma.
# DISCORD_CLIENT_ID=...
# DISCORD_CLIENT_SECRET=...
# DISCORD_REDIRECT_URI=https://vicehub.com/api/v1/auth/discord/callback

# Entrar com Google.
#
# Sem isto o botão da Google não aparece; entrar com email continua a
# funcionar, e o Discord também. Os três não dependem dos do Discord:
# dá para ter só um, os dois ou nenhum.
#
# Vêm da consola da Google, em APIs & Services → Credentials → Create
# credentials → OAuth client ID, do tipo "Web application". O endereço
# de retorno tem de estar lá registado tal e qual — a Google é ainda
# mais literal do que o Discord a compará-lo, e uma barra a mais
# devolve `redirect_uri_mismatch` antes de se chegar a ver o ecrã de
# autorização.
# GOOGLE_CLIENT_ID=....apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REDIRECT_URI=https://vicehub.com/api/v1/auth/google/callback


# ─────────────────────────────────────────────────────────────────────
# Afinações, com valores por omissão que servem
# ─────────────────────────────────────────────────────────────────────
# Só mexas nestas se souberes porquê. Os valores mostrados são os que a
# API usa se não disseres nada.

# API_HOST=0.0.0.0
# API_PORT=3000
# API_LOG_LEVEL=info

# Quanto duram as sessões, em segundos: 15 minutos e 30 dias.
# JWT_ACCESS_TOKEN_TTL_SECONDS=900
# JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# AUTH_COOKIE_NAME=vicehub_refresh_token

# Proteção contra tentativas de login à força. Ao fim de cinco falhas
# seguidas a conta fica bloqueada quinze minutos; entrar bem repõe o
# contador.
# AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
# AUTH_LOCKOUT_DURATION_SECONDS=900

# Limite das rotas de recuperação, muito mais apertado do que o global:
# pedir recuperações em massa é a forma barata de usar a plataforma para
# encher a caixa de correio de outra pessoa.
# AUTH_RECOVERY_RATE_LIMIT_MAX=5
# AUTH_RECOVERY_RATE_LIMIT_WINDOW=15 minutes

# Quanto duram os links enviados por email, em segundos.
#
# A recuperação é curta de propósito — é uma chave para entrar na conta,
# e uma caixa de correio comprometida ontem não deve abrir nada hoje. A
# confirmação não abre nada, e por isso dura um dia.
# PASSWORD_RESET_TTL_SECONDS=3600
# EMAIL_VERIFICATION_TTL_SECONDS=86400
