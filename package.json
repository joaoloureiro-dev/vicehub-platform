{
  "name": "vicehub",
  "version": "0.1.0",
  "private": true,
  "description": "Ecossistema SaaS gaming para jogadores, crews, servidores, criadores e marketplace.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run db:generate --workspace=@vicehub/database",
    "db:migrate:dev": "npm run db:migrate:dev --workspace=@vicehub/database",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=@vicehub/database",
    "db:validate": "npm run db:validate --workspace=@vicehub/database",
    "db:studio": "npm run db:studio --workspace=@vicehub/database"
  },
  "devDependencies": {
    "prettier": "3.9.1"
  }
}
