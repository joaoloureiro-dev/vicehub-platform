model RolePermission {
  id String @id @default(uuid())

  roleId       String
  permissionId String

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

/// Um evento de uma crew ou de um servidor.
///
/// Existe para responder a uma pergunta que a tesouraria não sabia
/// responder sozinha: *quem participou nisto?* Sem eventos, dividir
/// ganhos só podia ser por igual ou por cargo, e quem apareceu a um
/// assalto recebia o mesmo que quem não apareceu.
model Event {
  id String @id @default(uuid())

  /// Exatamente um destes é preenchido, tal como na carteira. A
  /// restrição está garantida por um CHECK na base de dados, porque o
  /// Prisma não a sabe exprimir.
  crewId   String?
  serverId String?

  name        String
  description String?

  status EventStatus @default(scheduled)

  starts_at DateTime
  ends_at   DateTime?

  /// Quantos podem participar. Sem valor é sem limite.
  capacity Int?

  /// Se este evento aparece fora da comunidade que o marcou.
  ///
  /// Por omissão não aparece, e o valor por omissão é a decisão toda: o
  /// calendário de uma comunidade é dela, e nada passa a público por ter
  /// aparecido uma coluna. Quem organiza é que marca, evento a evento, o
  /// que quer mostrar a quem ainda não entrou.
  is_public Boolean @default(false)

  /// Quem organiza, e é quem confirma as presenças.
  organizer_id String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  crew   Crew?   @relation(fields: [crewId], references: [id], onDelete: Cascade)
  server Server? @relation(fields: [serverId], references: [id], onDelete: Cascade)

  participants     EventParticipant[]
  distributions    Distribution[]
  xpAwards         XpAward[]
  reputationAwards ReputationAward[]

  @@index([crewId, status])
  @@index([serverId, status])
  @@index([starts_at])
  @@index([is_deleted])
  /// A montra pergunta sempre o mesmo: os públicos, por ordem de começo.
  @@index([is_public, starts_at])
}

/// A amizade entre duas pessoas.
///
/// Uma relação, e não duas linhas. Guardar "A é amigo de B" e "B é amigo
/// de A" em separado é guardar a mesma coisa duas vezes, e duas cópias
/// divergem sempre.
///
/// O par está ordenado — userAId é sempre o menor — e isso é imposto por
/// um CHECK na base: (A,B) e (B,A) são a mesma linha, e ninguém pode ser
/// amigo de si próprio, porque nenhum identificador é menor do que ele
/// mesmo.
model Friendship {
  id String @id @default(uuid())

  /// Sempre por esta ordem: userAId < userBId.
  userAId String
  userBId String

  /// O mesmo vocabulário das adesões: pedido, aceite, recusado, desfeito.
  status MembershipStatus @default(pending)

  /// Quem pediu. Sem isto não se sabe a quem cabe responder — e quem
  /// pede não pode aceitar-se a si próprio.
  requested_by String
  responded_at DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  userA User @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@index([userAId, status])
  @@index([userBId, status])
}

/// Um ganho de xp, gravado como facto e não como soma.
///
/// O xp de uma crew podia ser uma coluna que alguém incrementa. Não é,
/// por duas razões. A primeira é que um incremento não sabe repetir-se
/// sem estragar: dois pedidos a concluir o mesmo evento somavam duas
/// vezes, e não havia como saber que já tinha sido pago. A segunda é
/// que "porque é que esta crew está no nível 4?" tem de ter resposta —
/// e a resposta é uma lista de linhas destas.
///
/// A coluna `xp` do dono continua a existir e é a soma disto. Quem
/// pergunta o nível lê a coluna; quem pergunta porquê lê a tabela.
model XpAward {
  id String @id @default(uuid())

  /// O dono do ganho: uma pessoa ou uma crew, nunca os dois.
  ///
  /// Os servidores não aparecem aqui porque não têm nível: um evento de
  /// servidor dá xp a quem apareceu, e a mais ninguém.
  userId String?
  crewId String?

  amount Int
  reason XpReason

  /// O evento de onde veio, quando veio de um.
  ///
  /// É por esta coluna que os índices impedem que o mesmo evento pague
  /// duas vezes ao mesmo dono.
  eventId String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  crew  Crew?  @relation(fields: [crewId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([crewId, created_at(sort: Desc)])
  @@index([userId, created_at(sort: Desc)])
  @@index([eventId])
}

/// Uma pergunta no fórum.
///
/// O fórum é o primeiro sítio da plataforma onde o público escreve texto
/// que outras pessoas leem, e o modelo reflete-o em dois sítios.
///
/// O `authorId` é opcional porque uma conta apagada deixa de ter linha
/// para onde apontar — o tópico fica, para as respostas dele não ficarem
/// penduradas no vazio.
///
/// E o `body` é opcional pela mesma razão, mas por uma promessa e não por
/// uma limitação: quem apaga a conta é avisado de que **o seu texto é
/// apagado**, e o que escreveu aqui é texto seu. Vazio quer dizer
/// "retirado com a conta", e é assim que é mostrado.
/// Porque é que alguém denunciou uma publicação do fórum.
///
/// Enum e não texto livre: a razão é o que faz um moderador decidir o
/// que abrir primeiro, e uma lista fechada é ordenável e contável. O
/// texto que a pessoa queira acrescentar vai no `note`, que é dela.
enum ReportReason {
  /// Publicidade, links a granel, a mesma mensagem em todo o lado.
  spam

  /// Insulto, perseguição, ódio. É o que tira gente da plataforma.
  abuse

  /// Não é sobre a pergunta. O remédio costuma ser fechar, não apagar.
  off_topic

  /// O resto, com o `note` a dizer o quê.
  other
}

/// O que um moderador concluiu sobre uma denúncia.
///
/// `dismissed` existe por uma razão prática: sem ele, uma denúncia sem
/// razão voltava à fila para o moderador seguinte a analisar outra vez.
/// Dizer "foi visto e está bem" é trabalho que não se repete.
enum ReportStatus {
  open
  acted
  dismissed
}

/// Uma denúncia de uma publicação do fórum.
///
/// Existe porque sem ela a moderação dependia de sorte: alguém tinha de
/// calhar de ler a publicação para ela ser vista. Quem lê é quem
/// encontra, e isto é o que lhe dá por onde avisar.
///
/// **Aponta para uma coisa só** — ou a pergunta, ou a resposta —, e é a
/// base de dados que o garante. Uma denúncia sem alvo, ou com dois, não
/// é uma denúncia: é uma linha que o moderador não sabe abrir.
///
/// **Uma por pessoa e por publicação**, também pela base de dados. Sem
/// isso, a própria fila de denúncias passava a ser a maneira mais barata
/// de encher o ecrã de um moderador.
model Report {
  id String @id @default(uuid())

  /// Exatamente um destes está preenchido.
  ///
  /// Eram dois e passaram a três quando o mercado abriu. Não é uma
  /// coluna a mais: é a plataforma a ter uma segunda superfície onde o
  /// público escreve, e uma fila só onde as duas se denunciam. Duas
  /// filas dariam duas caixas de entrada para o mesmo trabalho, e uma
  /// delas ficaria por abrir.
  topicId   String?
  replyId   String?
  listingId String?
  messageId String?

  /// Sai quando a conta sai; a denúncia fica, porque o que ela aponta
  /// continua lá e o moderador ainda tem de decidir.
  reporterId String?

  reason ReportReason

  /// O que quem denunciou escreveu, se escreveu.
  ///
  /// Opcional, e apagável: é texto dessa pessoa, e a plataforma promete
  /// a quem sai que o seu texto é apagado.
  note String?

  status     ReportStatus @default(open)
  handled_at DateTime?
  handled_by String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  version    Int      @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  topic    ForumTopic?    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  reply    ForumReply?    @relation(fields: [replyId], references: [id], onDelete: Cascade)
  listing  MarketListing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  message  MarketMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter User?          @relation(fields: [reporterId], references: [id], onDelete: SetNull)

  @@unique([reporterId, topicId])
  @@unique([reporterId, replyId])
  @@unique([reporterId, listingId])
  @@unique([reporterId, messageId])
  /// A fila do moderador: as abertas, mais velhas primeiro.
  @@index([status, created_at])
  @@index([topicId])
  @@index([replyId])
  @@index([listingId])
  @@index([messageId])
}

model ForumTopic {
  id String @id @default(uuid())

  authorId String?

  title String
  body  String?

  /// Quando um moderador fechou o tópico a respostas novas.
  locked_at DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  author  User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  replies ForumReply[]
  reports Report[]

  @@index([created_at(sort: Desc)])
  @@index([authorId])
}

/// Uma resposta a uma pergunta do fórum.
///
/// As mesmas duas regras do tópico: o autor sai quando a conta sai, e o
/// texto é retirado com ela.
model ForumReply {
  id String @id @default(uuid())

  topicId  String
  authorId String?

  body String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  topic   ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author  User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  reports Report[]

  @@index([topicId, created_at])
  @@index([authorId])
}

/// Uma notícia de fora, guardada para o bloco da página de entrada.
///
/// O que aqui está é o que um **agregador** guarda: o título, um excerto
/// curto, a fonte e o endereço de lá. O artigo é de quem o escreveu, e
/// copiá-lo para cá seria pegar no trabalho de outra pessoa — o que se
/// mostra serve para decidir se se quer ler, e quem quiser lê no sítio
/// dele.
///
/// Nada disto é escrito por alguém desta plataforma: entra todo pela
/// recolha do feed, que corre num cron. É por isso que não há autor nem
/// `created_by` com significado.
model NewsItem {
  id String @id @default(uuid())

  /// A identidade do artigo no feed de origem.
  ///
  /// É por ela que a mesma notícia não entra duas vezes a cada recolha.
  /// Um feed que não dê identificador nenhum deixa o próprio endereço
  /// fazer de chave, que é a segunda coisa mais estável que ele tem.
  guid String

  /// Como a fonte se chama a si própria, saída do título do feed.
  ///
  /// Guardada por notícia e não em configuração: o dia em que a fonte
  /// mudar, as notícias antigas continuam a dizer de onde vieram.
  source_name String

  title     String
  excerpt   String?
  url       String
  image_url String?

  /// Quando saiu, segundo o feed. É por aqui que se ordena.
  published_at DateTime

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source SourceType @default(webhook)

  @@index([published_at(sort: Desc)])
}

/// Uma mudança na reputação de alguém, e o facto que a causou.
///
/// Existe pela mesma razão que o `XpAward`: sem ela o número no perfil
/// só se podia acreditar. Com ela, cada ponto tem um evento por trás e
/// quem o organizou por testemunha.
///
/// Só tem dono pessoa. A reputação é de quem aparece, e uma crew não
/// aparece a lado nenhum — o que a crew ganha com um evento é xp.
///
/// O `amount` é assinado: uma falta grava um valor negativo em vez de
/// uma linha "a menos" de outro tipo. Assim a soma das linhas é o
/// número, sempre, e não há duas maneiras de chegar ao mesmo sítio.
model ReputationAward {
  id String @id @default(uuid())

  userId String

  amount Int
  reason ReputationReason

  /// O evento de onde veio.
  ///
  /// É por esta coluna que o índice impede que o mesmo evento mexa duas
  /// vezes na reputação da mesma pessoa.
  eventId String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([userId, created_at(sort: Desc)])
  @@index([eventId])
}

/// A participação de alguém num evento.
///
/// A inscrição e a presença são distintas de propósito: `signed_up` diz
/// que tenciona ir, `confirmed` que quem organiza afirma que foi. É essa
/// confirmação, e não a inscrição, que dá direito a parte dos ganhos.
model EventParticipant {
  id String @id @default(uuid())

  eventId String
  userId  String

  status EventParticipantStatus @default(signed_up)

  /// Peso desta participação na divisão dos ganhos.
  ///
  /// Existe porque nem toda a participação vale o mesmo: quem lidera um
  /// assalto costuma levar mais, e obrigar a partes iguais faria as
  /// comunidades voltarem a dividir fora da plataforma. Quem organiza é
  /// que o define, ao confirmar a presença.
  weight Int @default(1)

  /// Quem confirmou a presença, e quando.
  confirmed_by String?
  confirmed_at DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Uma pessoa aparece uma vez por evento. Desistir e voltar a
  /// inscrever-se reaproveita a mesma linha, para que o histórico não
  /// se multiplique.
  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([userId])
}

/// Um evento de webhook já processado.
///
/// O Stripe reenvia eventos quando não recebe resposta a tempo, e o
/// mesmo evento pode chegar várias vezes. Sem esta tabela, um reenvio de
/// `checkout.session.completed` criaria um segundo período de plano — o
/// cliente pagou uma vez e ficaria com dois meses.
///
/// O identificador é o do próprio evento no Stripe, e é a chave
/// primária: a segunda tentativa de o gravar falha, e é essa falha que
/// diz que já foi tratado.
model WebhookEvent {
  /// O `evt_...` atribuído pelo fornecedor.
  id String @id

  provider SubscriptionProvider @default(stripe)
  type     String

  received_at  DateTime  @default(now())
  processed_at DateTime?

  /// Guardado para se poder investigar um evento que correu mal.
  payload Json?

  @@index([provider, type])
  @@index([received_at(sort: Desc)])
}

/// Um token enviado por email para recuperar a password ou confirmar o
/// endereço.
///
/// O que segue para o email é um segredo aleatório; o que fica gravado é
/// o seu resumo. Quem puser os olhos na base de dados encontra tokens que
/// não consegue usar — a mesma razão por que as passwords não se guardam
/// em claro.
model AccountToken {
  id String @id @default(uuid())

  userId  String
  purpose AccountTokenPurpose

  /// SHA-256 do segredo, em hexadecimal.
  ///
  /// Não é argon2, ao contrário das passwords e dos refresh tokens, e a
  /// diferença é deliberada: um segredo de 32 bytes aleatórios não tem
  /// nada que se adivinhe, por isso uma função lenta não compra
  /// segurança nenhuma. Compra, isso sim, uma leitura direta por índice
  /// em vez de percorrer candidatos.
  token_hash String @unique

  expires_at DateTime

  /// Quando foi usado. Um token serve uma vez.
  used_at DateTime?

  /// Quando foi invalidado sem ter sido usado — por exemplo, porque a
  /// pessoa pediu outro.
  invalidated_at DateTime?

  /// De onde veio o pedido, para o caso de ser preciso investigar.
  requested_ip  String?
  requested_via String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expires_at])
  /// O nome vem da migração que o criou. Sem o `map`, o Prisma via um
  /// índice com outro nome e a migração seguinte renomeava-o por nada.
  @@index([userId, purpose, used_at, invalidated_at], map: "AccountToken_open_idx")
}

/// Uma conquista de uma pessoa ou de uma crew.
///
/// Todas nascem de factos que a plataforma já regista — uma conquista de
/// presenças conta linhas de XpAward, que só existem porque alguém
/// confirmou que a pessoa apareceu a um evento que chegou ao fim.
/// Nenhuma é atribuída à mão.
///
/// É o que as torna difíceis de falsificar, e é a razão de existirem: um
/// perfil que diz "50 eventos" e não o consegue provar não vale nada a
/// quem está a decidir se aceita essa pessoa.
model Achievement {
  id String @id @default(uuid())

  /// Exatamente um destes é preenchido, como na Subscription e na
  /// Wallet. A restrição está garantida por um CHECK na base de dados,
  /// porque o Prisma não a sabe exprimir.
  userId String?
  crewId String?

  /// Qual é a conquista. Os identificadores vivem no catálogo, em
  /// src/achievements.ts, e não são inventados aqui.
  slug String

  /// Quando foi ganha.
  ///
  /// É o que distingue uma conquista de uma etiqueta. Podiam ser
  /// calculadas a cada leitura a partir das contagens — e seriam sempre
  /// coerentes — mas perdia-se isto.
  earned_at DateTime @default(now())

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  crew Crew? @relation(fields: [crewId], references: [id], onDelete: Cascade)

  /// Os nomes vêm das migrações que os criaram, como no AccountToken.
  @@index([userId, earned_at(sort: Desc)], map: "Achievement_user_earned_idx")
  @@index([crewId, earned_at(sort: Desc)], map: "Achievement_crew_earned_idx")
}

/// Em que gaveta é que o anúncio cai.
///
/// Lista fechada porque é por aqui que se filtra um mercado grande. O
/// `other` existe para o que não coube: sem ele, o que não coubesse ia
/// parar à gaveta errada e estragava as outras.
enum MarketCategory {
  vehicle
  property
  business
  service
  item
  other
}

/// Em que pé está o anúncio.
///
/// Vendido e retirado são estados diferentes de propósito: um diz por
/// quanto é que a coisa saiu, o outro diz que não saiu. Juntá-los
/// poupava uma coluna e perdia a única série de preços que a plataforma
/// vai ter sobre a economia de um servidor.
enum MarketListingStatus {
  open
  sold
  withdrawn
}

/// Um anúncio no mercado de um servidor.
///
/// O preço é **moeda de jogo**, e não há aqui pagamento nenhum: o
/// anúncio diz por quanto, e a troca acontece dentro do jogo entre as
/// duas pessoas. Nada nesta tabela toca em dinheiro real, e os termos
/// proíbem que alguém o tente.
///
/// Pertence a um servidor porque as economias são separadas: um carro
/// vendido num servidor não vale nada noutro, e um mercado comum a
/// todos seria uma lista de coisas que ninguém pode comprar.
model MarketListing {
  id String @id @default(uuid())

  serverId String

  /// Quem anuncia. Fica nulo quando a conta é apagada, tal como no
  /// fórum: o anúncio e o preço por que saiu continuam a interessar ao
  /// mercado depois de quem o escreveu se ir embora.
  sellerId String?

  category MarketCategory
  title    String
  body     String

  /// O que se pede, em moeda de jogo. `BigInt` como o resto do dinheiro
  /// do produto — uma economia de jogo passa dos milhões sem esforço.
  price BigInt

  /// Uma imagem do que se vende, se quem anuncia tiver uma.
  ///
  /// O ViceHub não aloja imagens: guarda o endereço, como faz com os
  /// avatares. Uma fotografia do carro é metade do anúncio, e não a ter
  /// deixava o mercado a ser uma lista de títulos.
  imageUrl String?

  status    MarketListingStatus @default(open)
  /// Quando deixou de estar à venda, seja por ter saído ou por ter sido
  /// retirado. Nulo enquanto estiver aberto.
  closed_at DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  server              Server               @relation(fields: [serverId], references: [id], onDelete: Cascade)
  seller              User?                @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  reports             Report[]
  marketConversations MarketConversation[]

  /// O índice da única listagem que existe: os anúncios de um servidor,
  /// num estado, do mais recente para o mais antigo.
  @@index([serverId, status, updated_at(sort: Desc)])
  @@index([serverId, category])
  @@index([sellerId])
}

/// Uma conversa sobre um anúncio, entre quem vende e quem pergunta.
///
/// É a peça que faltava para o mercado servir para alguma coisa: um
/// anúncio dizia "entrego no parque do porto" e não havia por onde
/// combinar nada. Sem isto, a conversa acontecia toda no Discord, e o
/// mercado era um placard.
///
/// Uma por anúncio e por interessado. Duas pessoas diferentes a
/// perguntar pelo mesmo carro são duas conversas, e a mesma pessoa a
/// voltar ao mesmo anúncio volta à conversa que já tinha — o índice
/// único é o que o garante, e não uma leitura antes da escrita.
///
/// **Quem vende não está aqui.** É lido do anúncio: um anúncio tem um
/// vendedor, e guardá-lo outra vez nesta tabela era a mesma verdade em
/// dois sítios à espera de divergir.
model MarketConversation {
  id String @id @default(uuid())

  listingId String

  /// Quem perguntou. Nulo quando a conta sai; a conversa fica, porque
  /// do outro lado continua a haver uma pessoa que a leu.
  buyerId String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  listing  MarketListing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer    User?           @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  messages MarketMessage[]

  @@unique([listingId, buyerId])
  /// A lista de conversas de uma pessoa, da mais recente para a mais
  /// antiga: é o que a caixa de entrada mostra.
  @@index([buyerId, updated_at(sort: Desc)])
  @@index([listingId])
}

/// Uma mensagem dentro de uma conversa.
///
/// **É privada.** Só as duas pessoas da conversa a leem — e um
/// moderador, se ela for denunciada, e só essa. A política de
/// privacidade diz isto por palavras, porque é a espécie de coisa que
/// uma pessoa tem o direito de saber antes de escrever.
model MarketMessage {
  id String @id @default(uuid())

  conversationId String

  /// Quem escreveu. Nulo quando a conta sai.
  senderId String?

  body String

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  conversation MarketConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?              @relation(fields: [senderId], references: [id], onDelete: SetNull)
  reports      Report[]

  /// Uma conversa lê-se do princípio para o fim.
  @@index([conversationId, created_at])
  @@index([senderId])
}
