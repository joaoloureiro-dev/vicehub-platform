generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SourceType {
  manual
  discord_bot
  webhook
  api
  system
  migration
}

enum MembershipType {
  user
  crew
  server
}

enum MembershipStatus {
  pending
  active
  rejected
  left
}

/// Uma movimentação nasce por responder e só entra no saldo quando é
/// aprovada. Sem estados, uma despesa proposta e uma despesa paga seriam
/// indistinguíveis, e os saldos atual, pendente e disponível seriam o
/// mesmo número.
enum TransactionStatus {
  pending
  approved
  rejected
  canceled
}

/// O sentido do dinheiro é explícito em vez de ser o sinal do montante:
/// um sinal trocado numa conta passa despercebido, um sentido trocado
/// não.
enum TransactionDirection {
  credit
  debit
}

/// Para que serviu o dinheiro. Segue as rubricas de tesouraria que uma
/// comunidade precisa de justificar.
enum TransactionCategory {
  contribution
  server_costs
  marketing
  event
  prize
  service
  payout
  other
}

/// Uma distribuição segue o mesmo circuito de um movimento: nasce por
/// responder e só move dinheiro quando alguém com autorização a aprova.
enum DistributionStatus {
  pending
  approved
  rejected
  canceled
}

/// Como a divisão foi calculada.
///
/// Existe para o histórico dizer não só quanto cada um recebeu, mas
/// porquê — e para que uma divisão sugerida por um cálculo automático
/// seja distinguível de uma escrita à mão.
enum DistributionBasis {
  equal
  by_role
  manual

  /// Divisão pelo peso de quem participou num evento.
  ///
  /// É a base que os eventos existem para permitir: quem apareceu ao
  /// assalto recebe, quem não apareceu não, e quem liderou pode receber
  /// mais — tudo a partir de presenças confirmadas, e não do que quem
  /// propõe diz que aconteceu.
  participation

  assisted
}

/// Estados por que passa um evento.
///
/// Não há estado "adiado": adiar é mudar a data de um evento agendado, e
/// um estado à parte para isso só faria haver duas formas de dizer o
/// mesmo.
enum EventStatus {
  scheduled
  ongoing
  completed
  canceled
}

/// O que aconteceu a quem se inscreveu num evento.
///
/// A inscrição e a presença são coisas distintas: quem se inscreve diz
/// que tenciona ir, e só quem organiza pode afirmar que foi. Sem essa
/// distinção, bastava inscrever-se para receber parte dos ganhos.
enum EventParticipantStatus {
  signed_up
  confirmed
  no_show
  withdrawn
}

/// De onde veio um ganho de xp.
///
/// Fica como enum, e não como texto livre, porque cada razão tem uma
/// regra de quanto vale e de quantas vezes pode acontecer — e uma razão
/// nova é uma decisão, não uma string.
enum XpReason {
  /// O evento chegou ao fim com gente lá. Vai para a crew que o marcou.
  event_completed

  /// Apareceu, e alguém o confirmou. Vai para a pessoa.
  event_attended
}

/// De onde veio uma mudança na reputação de alguém.
///
/// Enum e não texto livre, pela mesma razão que o do xp: cada razão tem
/// uma regra de quanto vale e de quando acontece, e uma razão nova é uma
/// decisão e não uma string.
enum ReputationReason {
  /// Apareceu a um evento que chegou ao fim, e quem o organizou
  /// confirmou-o. Soma.
  event_attended

  /// Disse que ia e não foi. Tira.
  event_missed
}

enum AuthProviderType {
  local
  discord
  google
  twitch
}

enum AuthSessionStatus {
  active
  revoked
  expired
}

/// Para que serve um token de conta enviado por email.
///
/// Os dois casos partilham a mesma mecânica — segredo aleatório, guardado
/// em resumo, de uso único e com prazo — e por isso partilham a mesma
/// tabela. O propósito fica na linha para que um token pedido para
/// recuperar a password nunca sirva para confirmar um email, nem o
/// contrário.
enum AccountTokenPurpose {
  password_reset
  email_verification
}

enum RefreshTokenStatus {
  active
  rotated
  revoked
  expired
}

enum RoleScope {
  global
  crew
  server
  marketplace
}

enum PermissionScope {
  global
  auth
  user
  crew
  server
  marketplace
  treasury
  event
  social
  forum
  system
}

enum SubscriptionPlan {
  premium

  /// Os escalões de um servidor, por ordem de tamanho.
  ///
  /// O que um servidor compra não é o que uma pessoa compra: é o
  /// direito a ter crews a jogar lá, e esse direito tem tamanhos.
  ///
  /// Os nomes não dizem o número de propósito — quantas crews cada um
  /// dá vive no catálogo, em código. Um `server_10` passaria a mentir
  /// na primeira alteração, e o nome fica gravado em cada linha de
  /// subscrição para sempre.
  server_base
  server_plus
  server_unlimited

  /// Acesso premium que não termina nem se cobra.
  ///
  /// Existe para quem apoiou a plataforma no princípio. É concedido um a
  /// um por quem administra — nunca automaticamente por ordem de
  /// chegada, porque quem merece o gesto é uma decisão de pessoas.
  lifetime
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  expired
}

enum SubscriptionProvider {
  manual
  stripe
}

model User {
  id String @id @default(uuid())

  email    String @unique
  username String @unique

  avatarUrl String?
  bio       String?

  /// Personalização reservada a quem tem plano ativo. Os campos ficam
  /// gravados mesmo que o plano termine: quem voltar a subscrever
  /// reencontra o que tinha, e perder trabalho por deixar de pagar seria
  /// um castigo, não uma condição de acesso.
  banner_url   String?
  accent_color String?

  level      Int    @default(1)
  xp         BigInt @default(0)
  reputation Int    @default(0)

  email_verified_at DateTime?
  token_version     Int       @default(1)
  last_login_at     DateTime?

  /// Quando esta pessoa viu pela última vez as respostas às candidaturas
  /// que fez.
  ///
  /// Guarda-se o momento de ter olhado, e não uma marca por candidatura:
  /// o que se quer saber é se alguma resposta é mais recente do que a
  /// última vez que se foi ver, e isso responde-se comparando datas. Uma
  /// linha por candidatura seria uma segunda cópia de um facto que a
  /// própria candidatura já tem — e a cópia é que acaba por dizer o que
  /// a origem já não diz.
  ///
  /// `null` é quem nunca foi ver: tudo o que já foi respondido conta.
  answers_seen_at DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  memberships Membership[]
  wallet      Wallet?

  credentials       UserCredential?
  authProviders     UserAuthProvider[]
  authSessions      AuthSession[]
  userRoles         UserRole[]
  subscriptions     Subscription[]
  eventParticipants EventParticipant[]
  accountTokens     AccountToken[]
  xpAwards          XpAward[]
  reputationAwards  ReputationAward[]
  forumTopics       ForumTopic[]
  forumReplies      ForumReply[]
  reports           Report[]

  /// O que esta pessoa pôs à venda no mercado de um servidor.
  listings     MarketListing[]
  achievements Achievement[]

  /// As duas pontas da mesma tabela de amizades.
  ///
  /// São dois campos porque o par está ordenado e uma pessoa pode ser
  /// qualquer uma das pontas — não são dois tipos de amizade.
  friendshipsAsA      Friendship[]         @relation("FriendshipUserA")
  friendshipsAsB      Friendship[]         @relation("FriendshipUserB")
  marketConversations MarketConversation[]
  marketMessages      MarketMessage[]
}

model Crew {
  id String @id @default(uuid())

  /// O nome e a tag são únicos entre as crews que existem.
  ///
  /// A unicidade vive num índice parcial escrito à mão — filtrado por
  /// is_deleted — e não num @unique: apagar uma crew tem de devolver o
  /// nome dela a quem vier a seguir, incluindo a quem a apagou por se
  /// ter enganado a escrevê-lo.
  name        String
  tag         String
  description String?

  /// O que esta crew exige a quem se quer candidatar, em texto livre.
  ///
  /// Texto e não condições verificáveis: "falamos português", "jogamos
  /// à noite", "18+" não são coisas que a plataforma consiga confirmar,
  /// e uma candidatura recusada por uma regra que o servidor julgou
  /// cumprida seria pior do que não prometer nada. Quem lê decide se se
  /// candidata; quem manda na crew decide se aceita.
  join_requirements String?

  /// Se esta crew diz, ela própria, que está a recrutar.
  ///
  /// Não é deduzido de ter requisitos escritos nem de ter lugares
  /// livres: uma dedução dessas põe no quadro de recrutamento crews que
  /// nunca pediram para lá estar, e quem se candidatar leva com um
  /// silêncio que a plataforma provocou.
  ///
  /// A data serve para o anúncio envelhecer à vista de quem lê, em vez
  /// de ficar lá para sempre a dizer que sim. É escrita ao ligar e
  /// apagada ao desligar — voltar a ligar recomeça a contagem.
  is_recruiting    Boolean   @default(false)
  recruiting_since DateTime?

  /// Personalização reservada a quem tem plano ativo. Os campos ficam
  /// gravados mesmo que o plano termine: quem voltar a subscrever
  /// reencontra o que tinha, e perder trabalho por deixar de pagar seria
  /// um castigo, não uma condição de acesso.
  banner_url   String?
  accent_color String?

  level Int    @default(1)
  xp    BigInt @default(0)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  memberships Membership[]
  wallet      Wallet?

  userRoles     UserRole[]
  subscriptions Subscription[]
  events        Event[]

  /// O servidor onde a crew joga, quando existe. É uma lista porque o
  /// histórico fica: pedidos recusados e saídas continuam gravados.
  affiliations Affiliation[]

  xpAwards     XpAward[]
  achievements Achievement[]
}

/// Uma hora de vida de um servidor.
///
/// O heartbeat diz quantas pessoas estão lá **agora**, e sobrescrevia o
/// anterior: o servidor sabia o presente e não tinha passado nenhum. Sem
/// passado não há como ordenar um leaderboard nem desenhar uma
/// evolução — "500 pessoas agora" não distingue um servidor cheio todos
/// os dias de um que encheu hoje à tarde.
///
/// **Uma linha por servidor e por hora**, e não uma por batida. Um
/// servidor bate à porta de minuto a minuto: guardar cada batida dava
/// mil e quatrocentas linhas por dia e por servidor para responder a
/// perguntas que a hora responde igual de bem. Assim são vinte e quatro.
///
/// Guarda-se a soma e o número de amostras em vez da média já feita:
/// médias não se somam, e com estes dois números a média de um dia, de
/// uma semana ou de um mês calcula-se toda a partir das mesmas linhas.
model ServerActivityHour {
  id String @id @default(uuid())

  serverId String

  /// O início da hora, em UTC. É a chave do balde.
  hour DateTime

  /// Quantas batidas entraram nesta hora.
  samples Int @default(0)

  /// A soma das contagens, para a média sair daqui sem a guardar feita.
  players_sum Int @default(0)

  /// O pico da hora, que é o número que interessa a quem procura onde há
  /// gente — a média esconde a hora cheia dentro de um dia morto.
  players_max Int @default(0)

  /// A última contagem da hora, para o fim do gráfico não mentir.
  players_last Int @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, hour])
  /// A leitura de um servidor: as horas dele, da mais recente para trás.
  @@index([serverId, hour(sort: Desc)])
  /// E a limpeza, que apaga por idade e não por servidor.
  @@index([hour])
}

model Server {
  id String @id @default(uuid())

  /// O nome identifica o servidor no diretório público, tal como o nome
  /// de uma crew. Sem unicidade, dois servidores homónimos seriam
  /// indistinguíveis para quem procura onde jogar.
  ///
  /// Único entre os servidores que existem, e não para sempre: a
  /// unicidade está num índice parcial filtrado por is_deleted, pela
  /// mesma razão que a do nome de uma crew.
  name        String
  region      String?
  description String?

  /// O que este servidor exige a quem se quer candidatar.
  ///
  /// Igual ao das crews, e pela mesma razão: texto livre e não condições
  /// verificáveis. A plataforma não confirma nenhuma delas, e uma
  /// candidatura recusada por uma regra que o servidor julgou cumprida
  /// seria pior do que não prometer nada.
  join_requirements String?

  /// Personalização reservada a quem tem plano ativo. Os campos ficam
  /// gravados mesmo que o plano termine: quem voltar a subscrever
  /// reencontra o que tinha, e perder trabalho por deixar de pagar seria
  /// um castigo, não uma condição de acesso.
  banner_url   String?
  accent_color String?

  /// O que o dono marca à mão, e que só decide enquanto o servidor
  /// nunca tiver reportado por si. A partir do primeiro heartbeat,
  /// quem decide é o relógio.
  isOnline Boolean @default(false)

  /// A última vez que o servidor bateu à porta, e com quantas pessoas
  /// dentro. Nulos enquanto ninguém tiver instalado o recurso.
  last_heartbeat_at DateTime?
  players_online    Int?

  /// Quantas pessoas este servidor teve em média nos últimos sete dias.
  ///
  /// Sai do histórico hora a hora, e vive aqui para o diretório poder
  /// **ordenar** por ele: uma média de uma janela de tempo não se
  /// escreve num `orderBy` de Prisma, e a alternativa era escrever os
  /// filtros do diretório uma segunda vez em SQL — que é como uma regra
  /// acaba a divergir de si própria.
  ///
  /// Nulo enquanto o servidor não tiver passado nenhum. Isso é diferente
  /// de zero, e o diretório põe os nulos no fim em vez de os tratar como
  /// servidores vazios.
  ///
  /// **É um número datado**, e por isso é reescrito em dois momentos: a
  /// cada batida, e na passagem da limpeza, que recalcula o de toda a
  /// gente. Sem o segundo, um servidor que deixasse de reportar ficava
  /// para sempre com a média do dia em que morreu, e subia no diretório
  /// à frente de servidores vivos.
  players_average_7d Int?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  memberships Membership[]
  wallet      Wallet?

  userRoles     UserRole[]
  subscriptions Subscription[]
  events        Event[]

  /// As crews que jogam neste servidor, e as que o pediram.
  affiliations Affiliation[]

  apiKeys  ServerApiKey[]
  activity ServerActivityHour[]

  /// O mercado deste servidor.
  listings MarketListing[]

  /// O índice por onde o diretório filtra os servidores online.
  ///
  /// Existe na base de dados desde a migração que criou a coluna, e não
  /// estava aqui declarado. O esquema é a fonte da próxima migração:
  /// enquanto o índice fosse invisível daqui, o primeiro `migrate dev`
  /// que alguém corresse gerava uma migração que o **apagava** — e é
  /// ele que serve a única consulta que a listagem faz com filtro por
  /// tempo.
  @@index([last_heartbeat_at])
  /// O que o diretório usa para ordenar por quem tem gente.
  @@index([players_average_7d])
}

/// Uma chave que deixa um servidor de jogo falar com a plataforma.
///
/// O segredo não é guardado — guarda-se o resumo, como nos tokens de
/// conta. O prefixo fica em claro de propósito: é o que permite listar
/// chaves sem revelar nenhuma, e é por ele que a chave apresentada é
/// encontrada sem percorrer a tabela.
model ServerApiKey {
  id String @id @default(uuid())

  serverId String

  /// Nome dado por quem a criou, para distinguir "produção" de "teste".
  label  String
  prefix String @unique

  /// SHA-256 do segredo, em hexadecimal.
  key_hash String

  /// Serve para revogar o que já ninguém usa sem partir o que trabalha.
  last_used_at DateTime?
  revoked_at   DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
}

/// A ligação entre uma crew e o servidor onde ela joga.
///
/// Nasce como pedido e só passa a ativa quando alguém que manda no
/// servidor a aceita: uma crew a declarar sozinha onde joga não pode
/// valer nada, porque é daqui que vai sair o direito ao plano do
/// servidor. As duas pontas consentem.
///
/// Duas regras vivem em índices parciais, escritos à mão na migração
/// porque o Prisma não os sabe exprimir: uma crew tem no máximo uma
/// filiação ativa, e no máximo um pedido aberto a cada servidor.
model Affiliation {
  id String @id @default(uuid())

  crewId   String
  serverId String

  status MembershipStatus @default(pending)

  /// Quem pediu e quem respondeu. Sem isto, uma crew posta fora não
  /// tinha como distinguir isso de ter saído por vontade própria.
  requested_by String
  responded_at DateTime?
  responded_by String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  crew   Crew   @relation(fields: [crewId], references: [id], onDelete: Cascade)
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, status])
  @@index([crewId, status])
}

model Membership {
  id String @id @default(uuid())

  userId   String
  crewId   String?
  serverId String?

  type MembershipType

  /// Uma adesão começa pendente e só passa a ativa quando alguém com
  /// autorização a aceita. O cargo dentro da crew não vive aqui: é
  /// dado por UserRole com âmbito de crew, para que exista uma única
  /// fonte de verdade sobre quem pode o quê.
  status MembershipStatus @default(pending)

  /// O que quem se candidata escreveu ao candidatar-se.
  ///
  /// A comunidade escreve o que pede a quem entra; isto é a resposta.
  /// Texto livre e não campos fixos: o que cada uma quer saber muda, e
  /// um formulário com as perguntas de umas seria o formulário errado
  /// para as outras.
  ///
  /// Fica depois de respondido, e não é apagado ao aceitar ou recusar:
  /// é o que permite, meses depois, perceber com que ideia é que alguém
  /// entrou.
  message String?

  responded_at DateTime?
  responded_by String?

  /// O que quem decidiu escreveu ao decidir, quando escreveu.
  ///
  /// Existe para uma recusa poder deixar de ser um silêncio. Opcional,
  /// porque obrigar a justificar cada recusa faz com que se deixe de
  /// recusar — e uma candidatura sem resposta é pior do que um "não"
  /// seco.
  decision_note String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  crew   Crew?   @relation(fields: [crewId], references: [id], onDelete: Cascade)
  server Server? @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([userId])
  /// Na base de dados este índice é **parcial** — só as adesões
  /// recusadas e não eliminadas —, e a linguagem do Prisma não sabe
  /// dizer isso. O que aqui se pode garantir é o nome: sem ele, cada
  /// migração gerada propunha renomeá-lo, e uma delas acabaria por o
  /// recriar sem a condição que o torna pequeno.
  @@index([userId, responded_at(sort: Desc)], map: "Membership_rejected_idx")
  @@index([crewId])
  @@index([serverId])
  @@index([type])
  @@index([userId, type])
  @@index([status])
  @@index([crewId, status])
  @@index([serverId, status])
  @@index([is_deleted])
}

model Wallet {
  id String @id @default(uuid())

  /// Exatamente um destes é preenchido, tal como na Subscription. A
  /// restrição está garantida por um CHECK na base de dados, porque o
  /// Prisma não a sabe exprimir.
  userId   String? @unique
  crewId   String? @unique
  serverId String? @unique

  /// Saldo já liquidado, ou seja, a soma das movimentações aprovadas.
  /// É mantido dentro da mesma transação que aprova cada movimentação,
  /// e há um teste que o reconcilia com as próprias movimentações.
  balance BigInt @default(0)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  crew   Crew?   @relation(fields: [crewId], references: [id], onDelete: Cascade)
  server Server? @relation(fields: [serverId], references: [id], onDelete: Cascade)

  transactions  Transaction[]
  distributions Distribution[]

  @@index([userId])
  @@index([crewId])
  @@index([serverId])
}

model Transaction {
  id String @id @default(uuid())

  walletId String

  /// Sempre positivo. O sentido vive em direction, e um CHECK impede
  /// montantes nulos ou negativos.
  amount BigInt

  direction TransactionDirection
  category  TransactionCategory  @default(other)
  status    TransactionStatus    @default(pending)

  description String?

  /// A divisão de que esta linha faz parte, quando faz.
  distributionId String?

  /// A transferência de que esta linha é uma das duas pernas.
  ///
  /// Uma transferência entre tesourarias são duas linhas — um débito de
  /// um lado, um crédito do outro — gravadas na mesma transação e unidas
  /// por este identificador. Não há tabela de transferências: uma
  /// linha-resumo seria uma terceira versão da verdade ao lado das duas
  /// pernas, e as três acabariam por divergir.
  transferId String?

  /// Quem propôs e quem decidiu são pessoas diferentes por desenho: é o
  /// que permite auditar uma despesa até a quem a aprovou.
  requested_by String?
  decided_by   String?
  decided_at   DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  wallet       Wallet        @relation(fields: [walletId], references: [id], onDelete: Restrict)
  distribution Distribution? @relation(fields: [distributionId], references: [id], onDelete: Restrict)

  @@index([walletId])
  @@index([distributionId])
  @@index([category])
  @@index([status])
  @@index([walletId, status])
  @@index([walletId, created_at(sort: Desc)])
  @@index([transferId])
}

model UserCredential {
  id String @id @default(uuid())

  userId String @unique

  password_hash String

  password_updated_at DateTime @default(now())

  failed_login_attempts Int       @default(0)
  locked_until          DateTime?

  created_at DateTime  @default(now())
