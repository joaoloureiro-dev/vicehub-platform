generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SourceType {
  manual
  discord_bot
  webhook
  api
  system
  migration
}

enum MembershipType {
  user
  crew
  server
}

enum MembershipStatus {
  pending
  active
  rejected
  left
}

/// Uma movimentação nasce por responder e só entra no saldo quando é
/// aprovada. Sem estados, uma despesa proposta e uma despesa paga seriam
/// indistinguíveis, e os saldos atual, pendente e disponível seriam o
/// mesmo número.
enum TransactionStatus {
  pending
  approved
  rejected
  canceled
}

/// O sentido do dinheiro é explícito em vez de ser o sinal do montante:
/// um sinal trocado numa conta passa despercebido, um sentido trocado
/// não.
enum TransactionDirection {
  credit
  debit
}

/// Para que serviu o dinheiro. Segue as rubricas de tesouraria que uma
/// comunidade precisa de justificar.
enum TransactionCategory {
  contribution
  server_costs
  marketing
  event
  prize
  service
  payout
  other
}

/// Uma distribuição segue o mesmo circuito de um movimento: nasce por
/// responder e só move dinheiro quando alguém com autorização a aprova.
enum DistributionStatus {
  pending
  approved
  rejected
  canceled
}

/// Como a divisão foi calculada.
///
/// Existe para o histórico dizer não só quanto cada um recebeu, mas
/// porquê — e para que uma divisão sugerida por um cálculo automático
/// seja distinguível de uma escrita à mão.
enum DistributionBasis {
  equal
  by_role
  manual

  /// Divisão pelo peso de quem participou num evento.
  ///
  /// É a base que os eventos existem para permitir: quem apareceu ao
  /// assalto recebe, quem não apareceu não, e quem liderou pode receber
  /// mais — tudo a partir de presenças confirmadas, e não do que quem
  /// propõe diz que aconteceu.
  participation

  assisted
}

/// Estados por que passa um evento.
///
/// Não há estado "adiado": adiar é mudar a data de um evento agendado, e
/// um estado à parte para isso só faria haver duas formas de dizer o
/// mesmo.
enum EventStatus {
  scheduled
  ongoing
  completed
  canceled
}

/// O que aconteceu a quem se inscreveu num evento.
///
/// A inscrição e a presença são coisas distintas: quem se inscreve diz
/// que tenciona ir, e só quem organiza pode afirmar que foi. Sem essa
/// distinção, bastava inscrever-se para receber parte dos ganhos.
enum EventParticipantStatus {
  signed_up
  confirmed
  no_show
  withdrawn
}

enum AuthProviderType {
  local
  discord
  google
  twitch
}

enum AuthSessionStatus {
  active
  revoked
  expired
}

enum RefreshTokenStatus {
  active
  rotated
  revoked
  expired
}

enum RoleScope {
  global
  crew
  server
  marketplace
}

enum PermissionScope {
  global
  auth
  user
  crew
  server
  marketplace
  treasury
  event
  social
  system
}

enum SubscriptionPlan {
  premium

  /// Acesso premium que não termina nem se cobra.
  ///
  /// Existe para quem apoiou a plataforma no princípio. É concedido um a
  /// um por quem administra — nunca automaticamente por ordem de
  /// chegada, porque quem merece o gesto é uma decisão de pessoas.
  lifetime
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  expired
}

enum SubscriptionProvider {
  manual
  stripe
}

model User {
  id String @id @default(uuid())

  email    String @unique
  username String @unique

  avatarUrl String?
  bio       String?

  /// Personalização reservada a quem tem plano ativo. Os campos ficam
  /// gravados mesmo que o plano termine: quem voltar a subscrever
  /// reencontra o que tinha, e perder trabalho por deixar de pagar seria
  /// um castigo, não uma condição de acesso.
  banner_url   String?
  accent_color String?

  level      Int    @default(1)
  xp         BigInt @default(0)
  reputation Int    @default(0)

  email_verified_at DateTime?
  token_version     Int       @default(1)
  last_login_at     DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  memberships Membership[]
  wallet      Wallet?

  credentials   UserCredential?
  authProviders UserAuthProvider[]
  authSessions  AuthSession[]
  userRoles         UserRole[]
  subscriptions     Subscription[]
  eventParticipants EventParticipant[]
}

model Crew {
  id String @id @default(uuid())

  name        String  @unique
  tag         String  @unique
  description String?

  /// Personalização reservada a quem tem plano ativo. Os campos ficam
  /// gravados mesmo que o plano termine: quem voltar a subscrever
  /// reencontra o que tinha, e perder trabalho por deixar de pagar seria
  /// um castigo, não uma condição de acesso.
  banner_url   String?
  accent_color String?

  level     Int    @default(1)
  xp        BigInt @default(0)
  influence Int    @default(0)
  prestige  Int    @default(0)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  memberships Membership[]
  wallet      Wallet?

  userRoles     UserRole[]
  subscriptions Subscription[]
  events        Event[]
}

model Server {
  id String @id @default(uuid())

  /// O nome identifica o servidor no diretório público, tal como o nome
  /// de uma crew. Sem unicidade, dois servidores homónimos seriam
  /// indistinguíveis para quem procura onde jogar.
  name        String  @unique
  region      String?
  description String?

  /// Personalização reservada a quem tem plano ativo. Os campos ficam
  /// gravados mesmo que o plano termine: quem voltar a subscrever
  /// reencontra o que tinha, e perder trabalho por deixar de pagar seria
  /// um castigo, não uma condição de acesso.
  banner_url   String?
  accent_color String?

  isOnline Boolean @default(false)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  memberships Membership[]
  wallet      Wallet?

  userRoles     UserRole[]
  subscriptions Subscription[]
  events        Event[]
}

model Membership {
  id String @id @default(uuid())

  userId   String
  crewId   String?
  serverId String?

  type MembershipType

  /// Uma adesão começa pendente e só passa a ativa quando alguém com
  /// autorização a aceita. O cargo dentro da crew não vive aqui: é
  /// dado por UserRole com âmbito de crew, para que exista uma única
  /// fonte de verdade sobre quem pode o quê.
  status MembershipStatus @default(pending)

  responded_at DateTime?
  responded_by String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  crew   Crew?   @relation(fields: [crewId], references: [id], onDelete: Cascade)
  server Server? @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([crewId])
  @@index([serverId])
  @@index([type])
  @@index([userId, type])
  @@index([status])
  @@index([crewId, status])
  @@index([serverId, status])
  @@index([is_deleted])
}

model Wallet {
  id String @id @default(uuid())

  /// Exatamente um destes é preenchido, tal como na Subscription. A
  /// restrição está garantida por um CHECK na base de dados, porque o
  /// Prisma não a sabe exprimir.
  userId   String? @unique
  crewId   String? @unique
  serverId String? @unique

  /// Saldo já liquidado, ou seja, a soma das movimentações aprovadas.
  /// É mantido dentro da mesma transação que aprova cada movimentação,
  /// e há um teste que o reconcilia com as próprias movimentações.
  balance BigInt @default(0)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  crew   Crew?   @relation(fields: [crewId], references: [id], onDelete: Cascade)
  server Server? @relation(fields: [serverId], references: [id], onDelete: Cascade)

  transactions  Transaction[]
  distributions Distribution[]

  @@index([userId])
  @@index([crewId])
  @@index([serverId])
}

model Transaction {
  id String @id @default(uuid())

  walletId String

  /// Sempre positivo. O sentido vive em direction, e um CHECK impede
  /// montantes nulos ou negativos.
  amount BigInt

  direction TransactionDirection
  category  TransactionCategory  @default(other)
  status    TransactionStatus    @default(pending)

  description String?

  /// A divisão de que esta linha faz parte, quando faz.
  distributionId String?

  /// Quem propôs e quem decidiu são pessoas diferentes por desenho: é o
  /// que permite auditar uma despesa até a quem a aprovou.
  requested_by String?
  decided_by   String?
  decided_at   DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  wallet       Wallet        @relation(fields: [walletId], references: [id], onDelete: Restrict)
  distribution Distribution? @relation(fields: [distributionId], references: [id], onDelete: Restrict)

  @@index([walletId])
  @@index([distributionId])
  @@index([category])
  @@index([status])
  @@index([walletId, status])
  @@index([walletId, created_at(sort: Desc)])
}

model UserCredential {
  id String @id @default(uuid())

  userId String @unique

  password_hash String

  password_updated_at DateTime @default(now())

  failed_login_attempts Int       @default(0)
  locked_until          DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([locked_until])
  @@index([is_deleted])
}

model UserAuthProvider {
  id String @id @default(uuid())

  userId String

  provider         AuthProviderType
  provider_user_id String
  provider_email   String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, provider_user_id])
  @@index([userId])
  @@index([provider])
}

model AuthSession {
  id String @id @default(uuid())

  userId String

  status AuthSessionStatus @default(active)

  ip_address         String?
  user_agent         String?
  device_fingerprint String?

  expires_at DateTime

  revoked_at   DateTime?
  last_used_at DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([status])
  @@index([expires_at])
  @@index([userId, status])
}

model RefreshToken {
  id String @id @default(uuid())

  sessionId String

  token_hash String @unique

  status RefreshTokenStatus @default(active)

  expires_at DateTime

  rotated_at DateTime?
  revoked_at DateTime?
  used_at    DateTime?

  replaced_by_token_id String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([status])
  @@index([expires_at])
  @@index([sessionId, status])
  @@index([is_deleted])
}

model Subscription {
  id String @id @default(uuid())

  /// Exatamente um destes é preenchido. A restrição está garantida por um
  /// CHECK na base de dados, porque o Prisma não a sabe exprimir.
  userId   String?
  crewId   String?
  serverId String?

  plan     SubscriptionPlan     @default(premium)
  status   SubscriptionStatus   @default(active)
  provider SubscriptionProvider @default(manual)

  /// Preço cobrado neste período, guardado por linha para que o histórico
  /// continue exato depois de uma alteração de preços.
  price_cents Int
  currency    String @default("USD")

  current_period_start DateTime

  /// Fim do período. **Ausente quer dizer que não termina**, o que só é
  /// válido no plano vitalício.
  ///
  /// A ausência é a forma honesta de dizer "nunca acaba". Uma data muito
  /// distante, como o ano 9999, parece resolver e depois morde: aparece
  /// em ecrãs, entra em contas de dias restantes e ordena mal.
  current_period_end   DateTime?

  cancel_at_period_end Boolean   @default(false)
  canceled_at          DateTime?
  ended_at             DateTime?

  provider_customer_id     String?
  provider_subscription_id String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  crew   Crew?   @relation(fields: [crewId], references: [id], onDelete: Cascade)
  server Server? @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([provider, provider_subscription_id])
  @@index([userId, status])
  @@index([crewId, status])
  @@index([serverId, status])
  @@index([status, current_period_end])
  @@index([is_deleted])
}

/// Uma divisão de ganhos pelos membros.
///
/// Existe para que se aprove **a divisão inteira** e não vinte
/// movimentos soltos: sem ela, aprovar metade das linhas deixaria a
/// tesouraria num estado que ninguém decidiu.
///
/// A soma das linhas é sempre igual ao total, mesmo quando a divisão não
/// é exata: o resto é repartido em unidades inteiras em vez de ficar
/// perdido no arredondamento.
model Distribution {
  id String @id @default(uuid())

  /// A carteira de onde o dinheiro sai.
  walletId String

  total BigInt

  basis  DistributionBasis
  status DistributionStatus @default(pending)

  /// O evento de onde vieram os pesos, nas divisões por participação.
  ///
  /// Fica gravado para que se saiba porque é que aquelas pessoas em
  /// concreto foram pagas: sem isto, uma divisão por participação seria
  /// indistinguível de uma lista de nomes escolhida à mão.
  eventId String?

  note String?

  requested_by String?
  decided_by   String?
  decided_at   DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  wallet Wallet  @relation(fields: [walletId], references: [id], onDelete: Restrict)
  event  Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  lines Transaction[]

  @@index([walletId])
  @@index([status])
  @@index([walletId, status])
  @@index([eventId])
  @@index([created_at(sort: Desc)])
}

/// Registo do que foi feito, por quem e a quê.
///
/// Os campos created_by e updated_by dos outros modelos dizem quem tocou
/// por último; não dizem o que mudou de quê para quê, nem guardam as
/// ações que não alteram linha nenhuma. Sem esta tabela não há auditoria
/// financeira possível.
///
/// Nunca é alterado nem apagado: um registo de auditoria que se pode
/// reescrever não serve de prova.
model AuditLog {
  id String @id @default(uuid())

  /// Quem fez. Fica nulo quando a ação é do próprio sistema, e continua
  /// preenchido depois de a conta ser eliminada — por isso não há chave
  /// estrangeira: apagar o utilizador não pode apagar o rasto.
  actor_id String?

  /// O que fez, em minúsculas e separado por pontos, por exemplo
  /// "subscription.granted" ou "treasury.expense.approved".
  action String

  /// A que entidade, pelo nome do modelo e pelo seu identificador.
  entity_type String
  entity_id   String

  /// O estado antes e depois, quando faz sentido guardá-lo.
  before Json?
  after  Json?

  ip_address String?
  user_agent String?

  created_at DateTime @default(now())

  source SourceType @default(api)

  @@index([actor_id])
  @@index([action])
  @@index([entity_type, entity_id])
  @@index([created_at(sort: Desc)])
}

model Role {
  id String @id @default(uuid())

  name        String
  slug        String
  description String?

  scope RoleScope @default(global)

  is_system Boolean @default(false)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([slug, scope])
  @@index([scope])
  @@index([is_deleted])
}

model Permission {
  id String @id @default(uuid())

  name        String
  slug        String
  description String?

  scope PermissionScope @default(global)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  rolePermissions RolePermission[]

  @@unique([slug, scope])
  @@index([scope])
  @@index([is_deleted])
}

model UserRole {
  id String @id @default(uuid())

  userId String
  roleId String

  crewId   String?
  serverId String?

  assigned_at DateTime  @default(now())
  expires_at  DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  crew   Crew?   @relation(fields: [crewId], references: [id], onDelete: Cascade)
  server Server? @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([roleId])
  @@index([crewId])
  @@index([serverId])
  @@index([expires_at])
  @@index([is_deleted])
}

model RolePermission {
  id String @id @default(uuid())

  roleId       String
  permissionId String

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

/// Um evento de uma crew ou de um servidor.
///
/// Existe para responder a uma pergunta que a tesouraria não sabia
/// responder sozinha: *quem participou nisto?* Sem eventos, dividir
/// ganhos só podia ser por igual ou por cargo, e quem apareceu a um
/// assalto recebia o mesmo que quem não apareceu.
model Event {
  id String @id @default(uuid())

  /// Exatamente um destes é preenchido, tal como na carteira. A
  /// restrição está garantida por um CHECK na base de dados, porque o
  /// Prisma não a sabe exprimir.
  crewId   String?
  serverId String?

  name        String
  description String?

  status EventStatus @default(scheduled)

  starts_at DateTime
  ends_at   DateTime?

  /// Quantos podem participar. Sem valor é sem limite.
  capacity Int?

  /// Quem organiza, e é quem confirma as presenças.
  organizer_id String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  crew   Crew?   @relation(fields: [crewId], references: [id], onDelete: Cascade)
  server Server? @relation(fields: [serverId], references: [id], onDelete: Cascade)

  participants  EventParticipant[]
  distributions Distribution[]

  @@index([crewId, status])
  @@index([serverId, status])
  @@index([starts_at])
  @@index([is_deleted])
}

/// A participação de alguém num evento.
///
/// A inscrição e a presença são distintas de propósito: `signed_up` diz
/// que tenciona ir, `confirmed` que quem organiza afirma que foi. É essa
/// confirmação, e não a inscrição, que dá direito a parte dos ganhos.
model EventParticipant {
  id String @id @default(uuid())

  eventId String
  userId  String

  status EventParticipantStatus @default(signed_up)

  /// Peso desta participação na divisão dos ganhos.
  ///
  /// Existe porque nem toda a participação vale o mesmo: quem lidera um
  /// assalto costuma levar mais, e obrigar a partes iguais faria as
  /// comunidades voltarem a dividir fora da plataforma. Quem organiza é
  /// que o define, ao confirmar a presença.
  weight Int @default(1)

  /// Quem confirmou a presença, e quando.
  confirmed_by String?
  confirmed_at DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  version    Int       @default(1)

  source     SourceType @default(api)
  created_by String?
  updated_by String?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Uma pessoa aparece uma vez por evento. Desistir e voltar a
  /// inscrever-se reaproveita a mesma linha, para que o histórico não
  /// se multiplique.
  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([userId])
}
