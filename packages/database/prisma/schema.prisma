  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([status])
  @@index([expires_at])
  @@index([userId, status])
}

model RefreshToken {
  id String @id @default(uuid())

  sessionId String

  token_hash String @unique

  status RefreshTokenStatus @default(active)

  expires_at DateTime

  rotated_at DateTime?
  revoked_at DateTime?
  used_at    DateTime?

